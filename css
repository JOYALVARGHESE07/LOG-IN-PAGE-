
/* Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f3f4f6;
    color: #1f2937;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 24px;
}

.login-container {
    width: 100%;
    max-width: 420px;
}

.login-card {
    background-color: #ffffff;
    padding: 40px;
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
}

.logo {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: 3px;
    color: #596d48;
    margin-bottom: 32px;
}

h1 {
    font-size: 28px;
    margin-bottom: 10px;
}

.subtitle {
    color: #6b7280;
    font-size: 14px;
    margin-bottom: 30px;
    line-height: 1.5;
}

.form-group {
    margin-bottom: 22px;
}

label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
}

input[type="email"],
input[type="password"] {
    width: 100%;
    padding: 13px 14px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
}

input:focus {
    border-color: #596d48;
    box-shadow: 0 0 0 3px rgba(89, 109, 72, 0.15);
}

.password-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.password-label a,
.signup a {
    color: #596d48;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
}

.password-label a:hover,
.signup a:hover {
    text-decoration: underline;
}

.remember-me {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
}

.remember-me input {
    accent-color: #596d48;
}

.remember-me label {
    margin: 0;
    font-weight: 400;
    color: #4b5563;
}

button {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 6px;
    background-color: #596d48;
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s;
}

button:hover {
    background-color: #435537;
}

button:focus-visible,
a:focus-visible {
    outline: 3px solid #9aaf85;
    outline-offset: 3px;
}

.signup {
    text-align: center;
    margin-top: 26px;
    font-size: 14px;
    color: #6b7280;
}

.signup a {
    font-size: 14px;
    margin-left: 4px;
}

@media (max-width: 480px) {
    .login-card {
        padding: 28px 22px;
    }

    h1 {
        font-size: 25px;
    }
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    color: #1f2937;
}

.page {
    display: flex;
    min-height: 100vh;
}

.hero {
    flex: 1;
    padding: 50px;
    color: white;
    background:
        linear-gradient(
            rgba(12, 28, 45, 0.55),
            rgba(12, 28, 45, 0.65)
        ),
        url("images/odin-landscape.jpg") center / cover;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.brand {
    display: flex;
    align-items: center;
    gap: 16px;
}

.brand img {
    width: 60px;
    height: 60px;
    object-fit: contain;
}

.brand h2 {
    text-transform: uppercase;
    letter-spacing: 3px;
}

.hero-text {
    max-width: 480px;
    margin-bottom: 100px;
}

.hero-text h1 {
    font-size: clamp(2.5rem, 4vw, 4rem);
    margin-bottom: 20px;
}

.hero-text p {
    font-size: 1.1rem;
    line-height: 1.7;
}

.login-container {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    background: #f9fafb;
}

.login-card {
    width: 100%;
    max-width: 420px;
}

.login-card h1 {
    font-size: 2.2rem;
    margin-bottom: 12px;
}

.login-card > p {
    color: #6b7280;
    margin-bottom: 30px;
}

form label {
    display: block;
    font-weight: 600;
    margin: 20px 0 8px;
}

form input {
    width: 100%;
    padding: 14px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 1rem;
}

form input:focus {
    outline: 2px solid #596d48;
    border-color: transparent;
}

button {
    width: 100%;
    padding: 15px;
    margin-top: 28px;
    border: none;
    border-radius: 6px;
    background: #496b50;
    color: white;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #36533c;
}

.signup {
    text-align: center;
    margin-top: 25px;
}

.signup a {
    color: #496b50;
    font-weight: bold;
}

@media (max-width: 750px) {
    .page {
        flex-direction: column;
    }

    .hero {
        min-height: 300px;
        padding: 30px;
    }

    .hero-text {
        margin: 50px 0 0;
    }

    .login-container {
        padding: 35px 24px;
    }
}


